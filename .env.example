# MotherlyPulse Environment Variables
# Copy this file to .env on your server and insert your actual values.

# Required: Telegram Bot API token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: SQLite database path (preserve existing VPS setting)
MOTHERLYPULSE_DB_PATH=/app/data/motherlypulse.db

# AI Backend Configuration
# Options: disabled | remote | local | mock
# Use 'disabled' for deterministic-only mode (safe rollback),
# or 'remote' when connecting to VPS llama-server or a cloud GPU endpoint.
AI_MODEL_BACKEND=disabled
AI_MODEL_NAME=chewie-1.2

# Remote Endpoint (e.g. VPS llama.cpp server: http://chewie-llm:8080/v1/chat/completions)
AI_MODEL_ENDPOINT=http://chewie-llm:8080/v1/chat/completions

# Remote API Format: auto | openai | custom
# 'auto' detects '/v1/chat/completions' as OpenAI format automatically.
AI_MODEL_API_FORMAT=auto

# Optional Bearer token for authenticated remote endpoints (leave blank for internal llama-server)
AI_MODEL_API_KEY=

# Outbound HTTP timeout in seconds (45.0 - 60.0 recommended for CPU llama-server)
AI_MODEL_TIMEOUT=45.0
